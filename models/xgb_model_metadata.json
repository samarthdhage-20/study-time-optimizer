{
  "feature_order": [
    "difficulty",
    "importance",
    "performance",
    "study_hours"
  ],
  "target": "academic_performance_score",
  "random_state": 42,
  "dataset_source": "simulated",
  "target_bounds": [
    0,
    100
  ],
  "train_test_split": {
    "test_size": 0.2,
